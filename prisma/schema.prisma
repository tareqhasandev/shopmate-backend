generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DraftOrderStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

model Store {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String         @db.VarChar(160)
  slug       String         @unique @db.VarChar(180)
  currency   String         @default("USD") @db.Char(3)
  categories Category[]
  products   Product[]
  customers  Customer[]
  orders     DraftOrder[]
  carts      ShoppingCart[]
  aiAgentConversations AiAgentConversation[]
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("stores")
}

model Category {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId     String    @map("store_id") @db.Uuid
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String    @db.VarChar(120)
  slug        String    @db.VarChar(140)
  description String    @db.Text
  products    Product[]
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([storeId, slug])
  @@index([storeId, name])
  @@map("categories")
}

model Product {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId              String                @map("store_id") @db.Uuid
  store                Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categoryId           String                @map("category_id") @db.Uuid
  category             Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name                 String                @db.VarChar(180)
  slug                 String                @db.VarChar(200)
  description          String                @db.Text
  sku                  String                @db.VarChar(80)
  price                Decimal               @db.Decimal(12, 2)
  compareAtPrice       Decimal?              @map("compare_at_price") @db.Decimal(12, 2)
  brand                String                @db.VarChar(120)
  imageUrl             String                @map("image_url") @db.Text
  specifications       Json                  @default("{}") @db.JsonB
  tags                 Json                  @default("[]") @db.JsonB
  isActive             Boolean               @default(true) @map("is_active")
  isFeatured           Boolean               @default(false) @map("is_featured")
  inventory            Inventory?
  inventoryAdjustments InventoryAdjustment[]
  orderItems           DraftOrderItem[]
  cartItems            ShoppingCartItem[]
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([storeId, slug])
  @@unique([storeId, sku])
  @@index([storeId, categoryId, isActive])
  @@index([storeId, brand])
  @@index([storeId, isActive, isFeatured])
  @@map("products")
}

model Inventory {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId         String   @unique @map("product_id") @db.Uuid
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  availableQuantity Int      @map("available_quantity")
  reservedQuantity  Int      @default(0) @map("reserved_quantity")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("inventory")
}

model InventoryAdjustment {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantityChange   Int      @map("quantity_change")
  availableBefore  Int      @map("available_before")
  availableAfter   Int      @map("available_after")
  reservedQuantity Int      @map("reserved_quantity")
  reason           String   @db.VarChar(300)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([productId, createdAt])
  @@map("inventory_adjustments")
}

model Customer {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId   String       @map("store_id") @db.Uuid
  store     Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  fullName  String       @map("full_name") @db.VarChar(200)
  email     String       @db.VarChar(254)
  phone     String?      @db.VarChar(40)
  orders    DraftOrder[]
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([storeId, email])
  @@index([storeId, createdAt])
  @@map("customers")
}

model DraftOrder {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId      String           @map("store_id") @db.Uuid
  store        Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customerId   String?          @map("customer_id") @db.Uuid
  customer     Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  orderNumber  String           @map("order_number") @db.VarChar(40)
  status       DraftOrderStatus @default(DRAFT)
  subtotal     Decimal          @db.Decimal(12, 2)
  discount     Decimal          @default(0) @db.Decimal(12, 2)
  shippingCost Decimal          @default(0) @map("shipping_cost") @db.Decimal(12, 2)
  total        Decimal          @db.Decimal(12, 2)
  currency     String           @db.Char(3)
  notes        String?          @db.Text
  items        DraftOrderItem[]
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([storeId, orderNumber])
  @@index([storeId, status, createdAt])
  @@index([customerId, createdAt])
  @@map("draft_orders")
}

model DraftOrderItem {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String     @map("order_id") @db.Uuid
  order       DraftOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String     @map("product_id") @db.Uuid
  product     Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName String     @map("product_name") @db.VarChar(180)
  sku         String     @map("sku") @db.VarChar(80)
  unitPrice   Decimal    @map("unit_price") @db.Decimal(12, 2)
  quantity    Int
  lineTotal   Decimal    @map("line_total") @db.Decimal(12, 2)

  @@index([orderId])
  @@index([productId])
  @@map("draft_order_items")
}

model ShoppingCart {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId   String             @map("store_id") @db.Uuid
  store     Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items     ShoppingCartItem[]
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([storeId, updatedAt])
  @@map("shopping_carts")
}

model ShoppingCartItem {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId    String       @map("cart_id") @db.Uuid
  cart      ShoppingCart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String       @map("product_id") @db.Uuid
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([cartId, productId])
  @@index([productId])
  @@map("shopping_cart_items")
}

model AiAgentConversation {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId      String   @map("store_id") @db.Uuid
  cartId       String?  @map("cart_id") @db.Uuid
  draftOrderId String?  @map("draft_order_id") @db.Uuid
  messages     Json     @default("[]") @db.JsonB
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, updatedAt])
  @@map("ai_agent_conversations")
}
