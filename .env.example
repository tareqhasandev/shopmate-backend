# Copy to .env for local development. Never commit real credentials.
DATABASE_URL="postgresql://shopmate:local-only@localhost:5432/shopmate?schema=shopmate"
PORT=3001
CORS_ORIGINS="http://localhost:3000"
SHOPMATE_DEFAULT_STORE_ID="00000000-0000-4000-8000-000000000001"
# For a disposable public testing instance only, set true to allow unauthenticated REST writes and reads.
# Public mode is restricted to SHOPMATE_API_STORE_ID (or SHOPMATE_DEFAULT_STORE_ID) and is unsafe for real data.
SHOPMATE_PUBLIC_TEST_API=false
# Required when public test mode is disabled: use a random bearer secret of at least 32 characters.
SHOPMATE_API_TOKEN=
# Optional: bind the API credential or public test mode to one store; defaults to SHOPMATE_DEFAULT_STORE_ID.
SHOPMATE_API_STORE_ID=
NODE_ENV=development
